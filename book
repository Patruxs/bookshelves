#!/usr/bin/env sh

set -eu

SOURCE=$0
while [ -L "$SOURCE" ]; do
    SOURCE_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
    LINK_TARGET=$(readlink "$SOURCE")
    case "$LINK_TARGET" in
        /*) SOURCE=$LINK_TARGET ;;
        *) SOURCE=$SOURCE_DIR/$LINK_TARGET ;;
    esac
done

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
UNAME=$(uname -s 2>/dev/null || printf unknown)

IS_WINDOWS=false
if [ "${OS:-}" = "Windows_NT" ] || echo "$UNAME" | grep -Eq '^(MINGW|MSYS|CYGWIN)'; then
    IS_WINDOWS=true
fi

if [ -x "$ROOT_DIR/venv/bin/python" ]; then
    PYTHON_CMD="$ROOT_DIR/venv/bin/python"
elif [ "$IS_WINDOWS" = true ] && [ -x "$ROOT_DIR/venv/Scripts/python.exe" ]; then
    PYTHON_CMD="$ROOT_DIR/venv/Scripts/python.exe"
elif [ "$IS_WINDOWS" = true ] && [ -x "$ROOT_DIR/venv/Scripts/python" ]; then
    PYTHON_CMD="$ROOT_DIR/venv/Scripts/python"
else
    if [ "$IS_WINDOWS" = false ] && [ -d "$ROOT_DIR/venv" ]; then
        echo "venv/ was built for another OS; run ./setup.sh" >&2
    fi
    if command -v python3 >/dev/null 2>&1; then
        PYTHON_CMD="python3"
    else
        PYTHON_CMD="python"
    fi
fi

cd "$ROOT_DIR"
exec "$PYTHON_CMD" "$ROOT_DIR/scripts/cli.py" "$@"
