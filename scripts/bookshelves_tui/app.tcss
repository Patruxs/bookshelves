Screen {
    layout: vertical;
}

#header {
    dock: top;
    height: 1;
    background: $primary;
    color: $text;
}

#header-title {
    width: auto;
    text-style: bold;
    padding: 0 1;
}

#header-stats {
    width: 1fr;
    text-align: right;
    padding: 0 1;
}

#main {
    height: 1fr;
}

#sections {
    height: 1fr;
}

#sections ContentSwitcher {
    height: 1fr;
}

#sections TabPane {
    height: 1fr;
    padding: 0;
}

#sections TabPane > * {
    height: 1fr;
}

#status-bar {
    height: 1;
    padding: 0 1;
    background: $boost;
    color: $text-muted;
}

#status-bar.-running {
    color: $warning;
}

#status-bar.-done {
    color: $success;
}

#status-bar.-failed {
    color: $error;
}

OutputPane {
    height: 30%;
    border: round $surface-lighten-2;
}

Screen.-compact OutputPane {
    height: 25%;
}

OutputPane:focus-within {
    border: round $accent;
}

OutputPane #output-log {
    height: 1fr;
    background: transparent;
}

#main.-output-hidden OutputPane {
    display: none;
}

#main.-output-maximised #sections {
    display: none;
}

#main.-output-maximised OutputPane {
    height: 1fr;
}

ModalScreen.modal {
    align: center middle;
}

.modal-dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

.modal-dialog.-wide {
    width: 90;
}

.modal-dialog.-danger {
    border: round $error;
}

.modal-title {
    text-style: bold;
    margin-bottom: 1;
}

.modal-hint {
    color: $text-muted;
    margin-top: 1;
}

.modal-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

.modal-buttons Button {
    margin-left: 1;
}

#text-value {
    height: 12;
}

#select-options {
    height: auto;
    max-height: 16;
}

#help-body {
    height: auto;
    max-height: 30;
}

.help-section {
    margin-top: 1;
}

.section-title {
    text-style: bold;
    padding: 0 1;
    margin-bottom: 1;
}

#home-steps {
    height: 1fr;
}

.home-step {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    border-left: outer $surface-lighten-2;
}

.home-step.-highlighted {
    border-left: outer $accent;
    background: $boost;
}

Screen.-compact .home-step {
    margin-bottom: 0;
}

.step-heading {
    height: 1;
}

.step-title {
    width: 14;
    text-style: bold;
}

.step-status {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.step-status.-ok {
    color: $success;
}

.step-status.-pending {
    color: $warning;
}

.step-hint {
    color: $text-muted;
}

.step-actions {
    height: auto;
}

.step-actions Button {
    width: auto;
    min-width: 0;
    margin-right: 1;
}

Screen.-compact #step-inbox .step-actions {
    layout: grid;
    grid-size: 3;
    grid-rows: 1;
}

Screen.-compact #step-inbox .step-actions Button {
    width: 1fr;
}

#inbox-table {
    height: auto;
    max-height: 10;
}

Screen.-compact #inbox-table {
    max-height: 4;
}
